# Copia este archivo a .env. Estos valores son solo para desarrollo local.
APP_URL=http://localhost:3000

POSTGRES_USER=campusops
POSTGRES_PASSWORD=campusops_dev
POSTGRES_DB=campusops_dev
POSTGRES_PORT=5432

DATABASE_URL=postgresql://campusops:campusops_dev@localhost:5432/campusops_dev
DATABASE_URL_TEST=postgresql://campusops:campusops_dev@localhost:5432/campusops_test

# Obligatoria. Genera un valor propio con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Obligatoria. Secreto para guardar la IP de quien reporta como hash (nunca la IP).
# Distinto de BETTER_AUTH_SECRET. Genera uno con: openssl rand -base64 32
IP_HASH_SECRET=

# Contraseña de los usuarios de ejemplo. Solo para desarrollo.
SEED_USER_PASSWORD=CampusOps-Dev-2026
