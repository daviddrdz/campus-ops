# Copia este archivo a .env. Los valores de ejemplo son solo para desarrollo local.
# En producción (Vercel) las variables se cargan en el panel del proyecto, nunca en un
# archivo del repositorio. Ver "Despliegue" en README.md.

# URL pública de la app, sin "/" al final. Va dentro de cada QR: en producción debe ser
# la definitiva (p. ej. https://<proyecto>.vercel.app). Si cambia, los QR impresos dejan
# de servir. Better Auth también la usa como origen permitido para el login.
APP_URL=http://localhost:3000

# Solo para Docker Compose en local.
POSTGRES_USER=campusops
POSTGRES_PASSWORD=campusops_dev
POSTGRES_DB=campusops_dev
POSTGRES_PORT=5432

# Conexión que usa la app. En producción (Neon): la cadena CON pool (host con "-pooler").
DATABASE_URL=postgresql://campusops:campusops_dev@localhost:5432/campusops_dev
# Conexión directa para las migraciones (`prisma migrate deploy`). En producción (Neon):
# la cadena SIN pool. La integración de Neon con Vercel la crea con este nombre.
# En local se puede dejar sin definir: se usa DATABASE_URL.
# DATABASE_URL_UNPOOLED=
# Solo para las pruebas de integración en local; nunca en producción.
DATABASE_URL_TEST=postgresql://campusops:campusops_dev@localhost:5432/campusops_test

# Obligatoria. Mínimo 32 caracteres. Genera un valor propio con: openssl rand -base64 32
# Usa uno distinto en cada entorno (desarrollo y producción).
BETTER_AUTH_SECRET=

# Obligatoria. Secreto para guardar la IP de quien reporta como hash (nunca la IP).
# Distinto de BETTER_AUTH_SECRET. Genera uno con: openssl rand -base64 32
IP_HASH_SECRET=

# Contraseña de los usuarios de ejemplo del seed. Este valor es solo para desarrollo:
# contra una BD que no sea la local, el seed exige otra de al menos 12 caracteres.
# No se carga en Vercel: el seed de producción se corre desde la terminal.
SEED_USER_PASSWORD=CampusOps-Dev-2026
